---
import Navigation from '../components/common/Navigation.astro';
import { getLangFromUrl } from '../i18n/utils';
import '../styles/global.css';

interface Props {
	title: string;
    description?: string;
}

const { title, description = "B&B Van de Gruiterwonen - Mediterrane luxe in hartje Axel." } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        
		<title>{title}</title>
	</head>
	<body class="bg-brand-cream text-brand-taupe antialiased overflow-x-hidden selection:bg-brand-gold selection:text-white">
        <Navigation />
		<slot />
        
        <footer class="bg-brand-brown text-white py-12">
            <div class="container mx-auto px-6 text-center">
                <div class="flex justify-center mb-6">
                    <h2 class="font-heading text-3xl font-bold text-brand-gold">Van de Gruiterwonen</h2>
                </div>
                <div class="flex flex-col md:flex-row justify-center items-center gap-4 text-sm text-white/70">
                    <p>&copy; {new Date().getFullYear()} B&B Van de Gruiterwonen. Stationsstraat 34, 4571 LB Axel.</p>
                    <span class="hidden md:inline">•</span>
                    <p>Gemaakt door <a href="https://zee-zicht.nl" target="_blank" rel="noopener noreferrer" class="text-white font-bold hover:text-brand-gold transition-colors hover:underline">Zee-Zicht</a></p>
                </div>
            </div>
        </footer>
	</body>
</html>
