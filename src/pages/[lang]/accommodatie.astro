---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import { Wifi, Tv, Coffee, Car, Wind, Utensils, Clock, Key, Dog, CheckCircle } from 'lucide-react';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const content = {
  nl: {
    title: "Onze Suites",
    intro: "Van de Gruiterwonen biedt twee luxe studio's, van alle gemakken voorzien voor een comfortabel verblijf in hartje Axel.",
    facilitiesTitle: "Faciliteiten",
    facilities: [
      { icon: Wifi, text: "Gratis WiFi" },
      { icon: Car, text: "Gratis Parkeren" },
      { icon: Tv, text: "Smart TV (Netflix)" },
      { icon: Coffee, text: "Koffie & Thee" },
      { icon: Utensils, text: "Eigen Keuken" },
      { icon: CheckCircle, text: "Privé Terras" },
    ],
    studios: [
        {
            title: "Studio 2",
            desc: "Een comfortabele studio van 33m² met eigen entree en terras.",
            details: ["33 m²", "Privé badkamer", "Eigen keuken", "Privéterras", "Begane grond"],
            price: "Vanaf € 95,- per nacht"
        },
        {
            title: "Studio 3",
            desc: "Een ruime studio van 44m² voor extra comfort en ruimte.",
            details: ["44 m²", "Privé badkamer", "Eigen keuken", "Privéterras", "Begane grond"],
            price: "Vanaf € 115,- per nacht"
        }
    ],
    pricingTitle: "Tarieven & Info",
    pricingText: "Prijzen zijn inclusief handdoeken, beddengoed en eindschoonmaak. Ontbijt is inbegrepen.",
    cta: "Beschikbaarheid Checken",
    galleryTitle: "Sfeerimpressie",
    practicalTitle: "Praktisch",
    facilitiesIntro: "Luxe & Comfort",
    practical: [
        { icon: Key, label: "Inchecken", value: "Vanaf 15:00 uur" },
        { icon: Clock, label: "Uitchecken", value: "Tot 11:00 uur" },
        { icon: Coffee, label: "Ontbijt", value: "Inclusief (Luxe)" },
        { icon: Dog, label: "Huisdieren", value: "In overleg" }
    ]
  },
  en: {
    title: "Our Suites",
    intro: "Van de Gruiterwonen offers two luxury studios, fully equipped for a comfortable stay in the heart of Axel.",
    facilitiesTitle: "Facilities",
    facilities: [
      { icon: Wifi, text: "Free WiFi" },
      { icon: Car, text: "Free Parking" },
      { icon: Tv, text: "Smart TV (Netflix)" },
      { icon: Coffee, text: "Coffee & Tea" },
      { icon: Utensils, text: "Private Kitchen" },
      { icon: CheckCircle, text: "Private Terrace" },
    ],
    studios: [
        {
            title: "Studio 2",
            desc: "A comfortable studio of 33m² with private entrance and terrace.",
            details: ["33 m²", "Private bathroom", "Private kitchen", "Private terrace", "Ground floor"],
            price: "From € 95,- per night"
        },
        {
            title: "Studio 3",
            desc: "A spacious studio of 44m² for extra comfort and space.",
            details: ["44 m²", "Private bathroom", "Private kitchen", "Private terrace", "Ground floor"],
            price: "From € 115,- per night"
        }
    ],
    pricingTitle: "Rates & Info",
    pricingText: "Prices include towels, bed linen and final cleaning. Breakfast is included.",
    cta: "Check Availability",
    galleryTitle: "Impressions",
    practicalTitle: "Practical",
    facilitiesIntro: "Luxury & Comfort",
    practical: [
        { icon: Key, label: "Check-in", value: "From 15:00" },
        { icon: Clock, label: "Check-out", value: "Until 11:00" },
        { icon: Coffee, label: "Breakfast", value: "Included (Luxury)" },
        { icon: Dog, label: "Pets", value: "On request" }
    ]
  },
  de: {
    title: "Unsere Suiten",
    intro: "Van de Gruiterwonen bietet zwei Luxusstudios, komplett ausgestattet für einen komfortablen Aufenthalt im Herzen von Axel.",
    facilitiesTitle: "Ausstattung",
    facilities: [
      { icon: Wifi, text: "Gratis WiFi" },
      { icon: Car, text: "Kostenloses Parken" },
      { icon: Tv, text: "Smart TV (Netflix)" },
      { icon: Coffee, text: "Kaffee & Tee" },
      { icon: Utensils, text: "Eigene Küche" },
      { icon: CheckCircle, text: "Private Terrasse" },
    ],
    studios: [
        {
            title: "Studio 2",
            desc: "Ein komfortables Studio von 33m² mit eigenem Eingang und Terrasse.",
            details: ["33 m²", "Privates Badezimmer", "Eigene Küche", "Private Terrasse", "Erdgeschoss"],
            price: "Ab € 95,- pro Nacht"
        },
        {
            title: "Studio 3",
            desc: "Ein geräumiges Studio von 44m² für extra Komfort und Platz.",
            details: ["44 m²", "Privates Badezimmer", "Eigene Küche", "Private Terrasse", "Erdgeschoss"],
            price: "Ab € 115,- pro Nacht"
        }
    ],
    pricingTitle: "Preise & Infos",
    pricingText: "Preise beinhalten Handtücher, Bettwäsche und Endreinigung. Frühstück ist inbegriffen.",
    cta: "Verfügbarkeit Prüfen",
    galleryTitle: "Impressionen",
    practicalTitle: "Praktisch",
    facilitiesIntro: "Luxus & Komfort",
    practical: [
        { icon: Key, label: "Check-in", value: "Ab 15:00 Uhr" },
        { icon: Clock, label: "Check-out", value: "Bis 11:00 Uhr" },
        { icon: Coffee, label: "Frühstück", value: "Inklusive (Luxus)" },
        { icon: Dog, label: "Haustiere", value: "Auf Anfrage" }
    ]
  }
};

const c = content[lang as keyof typeof content];

import roomImage from '../../assets/images/vdg/vdg_11.webp'; // Studio 2 Main
import galleryImg1 from '../../assets/images/vdg/vdg_08.webp'; // Studio 3 Main
import galleryImg2 from '../../assets/images/vdg/vdg_04.webp'; // Bathroom/Kitchen
import galleryImg3 from '../../assets/images/vdg/vdg_13.webp'; // Breakfast
import { Image } from 'astro:assets';
---

<Layout title={`B&B Van de Gruiterwonen | ${c.title}`}>
  <div class="pt-36 md:pt-36 pb-12 bg-brand-light">
    <div class="container mx-auto px-6">
      <!-- Intro Section -->
      <div class="text-center max-w-4xl mx-auto mb-20 animate-fade-in">
          <h1 class="text-5xl md:text-7xl font-heading font-black text-brand-brown mb-8">{c.title}</h1>
          <p class="text-xl text-brand-taupe/70 leading-relaxed font-light">{c.intro}</p>
      </div>

      <!-- Suites Layout - 2 Columns -->
      <div class="grid lg:grid-cols-2 gap-12 mb-24">
          {c.studios.map((studio, index) => (
             <div class="bg-white rounded-[40px] shadow-xl overflow-hidden border border-brand-gold/20 flex flex-col hover:shadow-2xl transition-all duration-300 group">
                <div class="h-64 overflow-hidden relative">
                    <div class="absolute inset-0 bg-brand-brown/10 z-10 group-hover:bg-transparent transition-colors"></div>
                    <Image src={index === 0 ? galleryImg1 : galleryImg2} alt={studio.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" quality="mid" />
                </div>
                <div class="p-8 flex flex-col flex-1">
                    <h2 class="text-3xl font-heading font-bold text-brand-brown mb-4">{studio.title}</h2>
                    <p class="text-brand-taupe/80 mb-6 flex-1">{studio.desc}</p>
                    <ul class="space-y-3 mb-8">
                        {studio.details.map(detail => (
                            <li class="flex items-center gap-3 text-brand-taupe/90">
                                <CheckCircle className="w-5 h-5 text-brand-gold" />
                                <span>{detail}</span>
                            </li>
                        ))}
                    </ul>
                    <div class="pt-6 border-t border-brand-gold/10 flex justify-between items-center">
                        <span class="font-bold text-brand-brown text-lg">{studio.price}</span>
                        <a href={getRelativeLocaleUrl(lang as string, 'boeken')} class="bg-brand-gold text-white px-6 py-2 rounded-full font-bold hover:bg-brand-brown transition-colors">
                            {c.cta}
                        </a>
                    </div>
                </div>
             </div>
          ))}
      </div>



      <!-- Photo Gallery Strip (Sfeerimpressie) -->
      <div class="mb-24 animate-slide-up delay-400">
         <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-brand-brown mb-12">{c.galleryTitle}</h2>
         <div class="grid md:grid-cols-3 gap-6">
             <div class="rounded-2xl overflow-hidden shadow-lg h-[300px] group border border-brand-gold/10">
                <Image src={galleryImg1} alt="Sfeerimpressie 1" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" quality="mid" />
             </div>
             <div class="rounded-2xl overflow-hidden shadow-lg h-[300px] group md:-mt-8 border border-brand-gold/10">
                <Image src={galleryImg2} alt="Sfeerimpressie 2" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" quality="mid" />
             </div>
             <div class="rounded-2xl overflow-hidden shadow-lg h-[300px] group border border-brand-gold/10">
                <Image src={galleryImg3} alt="Sfeerimpressie 3" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" quality="mid" />
             </div>
         </div>
      </div>

      <!-- Practical Info Grid -->
      <div class="bg-white p-10 rounded-[40px] shadow-sm border border-brand-gold/20 animate-slide-up delay-500">
         <h2 class="text-3xl font-heading font-bold text-brand-brown mb-10 text-center">{c.practicalTitle}</h2>
         <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {c.practical.map(item => (
                <div class="text-center p-4">
                    <div class="w-12 h-12 bg-brand-light rounded-full flex items-center justify-center text-brand-gold mx-auto mb-4 border border-brand-gold/10">
                        <item.icon className="w-6 h-6" />
                    </div>
                    <h4 class="font-bold text-brand-brown mb-2">{item.label}</h4>
                    <p class="text-brand-taupe/70 text-sm">{item.value}</p>
                </div>
            ))}
         </div>
      </div>
    </div>
  </div>
</Layout>
