---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/home/Hero.astro';
import { languages } from '../../i18n/ui';
import { useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import { BedDouble, Coffee, Wifi, Map } from 'lucide-react';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const content = {
  nl: {
    heroTitle: "Rust & Ruimte",
    heroSubtitle: "Ontsnap aan de drukte in het hart van de Zeeuwse polder.",
    introTitle: "Welkom bij 't Stippie",
    introText: "Geniet van een onbezorgd verblijf in onze sfeervolle B&B. Gelegen aan de grens met België, bieden wij de perfecte uitvalsbasis voor natuurliefhebbers, fietsers en rustzoekers.",
    features: [
        { title: "Comfortabel Slapen", desc: "Ruim tweepersoonsbed & slaapbank", icon: BedDouble },
        { title: "Vers Ontbijt", desc: "Met streekproducten (optioneel)", icon: Coffee },
        { title: "Gratis WiFi", desc: "Snel internet & eigen werkplek", icon: Wifi },
        { title: "Toerisme", desc: "Nabij Gent, Antwerpen & Strand", icon: Map },
    ],
    imageFeatureTitle: "Rust & Comfort",
    ctaTitle: "Klaar om te ontspannen?",
    ctaText: "Boek direct jouw verblijf en geniet van de Zeeuwse gastvrijheid en rust in de polder."
  },
  en: {
    heroTitle: "Peace & Space",
    heroSubtitle: "Escape the hustle in the heart of the Zeeland polders.",
    introTitle: "Welcome to 't Stippie",
    introText: "Enjoy a carefree stay in our atmospheric B&B. Located on the border with Belgium, we offer the perfect base for nature lovers, cyclists, and peace seekers.",
    features: [
        { title: "Comfortable Sleep", desc: "Spacious double bed & sofa bed", icon: BedDouble },
        { title: "Fresh Breakfast", desc: "With local products (optional)", icon: Coffee },
        { title: "Free WiFi", desc: "Fast internet & workspace", icon: Wifi },
        { title: "Tourism", desc: "Near Ghent, Antwerp & Beach", icon: Map },
    ],
    imageFeatureTitle: "Peace & Comfort",
    ctaTitle: "Ready to Relax?",
    ctaText: "Book your stay directly and enjoy Zeeland hospitality and peace in the polder."
  },
  de: {
    heroTitle: "Ruhe & Raum",
    heroSubtitle: "Entfliehen Sie der Hektik im Herzen der seeländischen Polder.",
    introTitle: "Willkommen bei 't Stippie",
    introText: "Genießen Sie einen sorglosen Aufenthalt in unserem stimmungsvollen B&B. An der Grenze zu Belgien gelegen, bieten wir den perfekten Ausgangspunkt für Naturliebhaber und Radfahrer.",
    features: [

        { title: "Komfortabel Schlafen", desc: "Geräumiges Doppelbett & Schlafsofa", icon: BedDouble },
        { title: "Frisches Frühstück", desc: "Mit lokalen Produkten (optional)", icon: Coffee },
        { title: "Gratis WiFi", desc: "Schnelles Internet & Arbeitsplatz", icon: Wifi },
        { title: "Tourismus", desc: "Nahe Gent, Antwerpen & Strand", icon: Map },
    ],
    imageFeatureTitle: "Ruhe & Komfort",
    ctaTitle: "Bereit zum Entspannen?",
    ctaText: "Buchen Sie direkt Ihren Aufenthalt und genießen Sie die seeländische Gastfreundschaft."
  }
};

const c = content[lang as keyof typeof content];

import introImage from '../../assets/images/t_stippie_05.jpg'; // Changed to 5th image based on request
import { Image } from 'astro:assets';
---

<Layout title={`B&B 't Stippie | ${c.heroTitle}`}>
  <Hero 
    title={c.heroTitle}
    subtitle={c.heroSubtitle}
    ctaText={t('btn.book')}
    ctaLink={getRelativeLocaleUrl(lang as string, 'contact')}
  />

  <!-- Intro Section (Bento Grid) -->
  <section class="py-24 bg-brand-light relative overflow-hidden">
    <div class="container mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-20 animate-fade-in">
        <h2 class="text-5xl md:text-7xl font-heading font-black text-brand-green mb-6">{c.introTitle}</h2>
        <p class="text-xl text-brand-dark/70 leading-relaxed font-light">
          {c.introText}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[250px]">
          <!-- Large Feature Image -->
          <div class="md:col-span-2 lg:col-span-2 row-span-2 relative group overflow-hidden rounded-3xl shadow-2xl animate-slide-up delay-100">
                <Image src={introImage} alt="Relaxing Interior" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" quality="high" />
             <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-8">
                <h3 class="text-3xl font-bold text-white">{c.imageFeatureTitle}</h3>
             </div>
          </div>

          <!-- Feature Cards -->
          {c.features.map((f, i) => (
             <div class={`p-8 bg-white rounded-3xl shadow-lg border border-white/50 hover:shadow-2xl transition-all duration-300 group flex flex-col justify-between hover:-translate-y-2 animate-slide-up delay-${(i+2)*100} ${i === 0 || i === 3 ? 'md:col-span-1' : 'md:col-span-1'}`}>
                <div class="w-14 h-14 bg-brand-light rounded-2xl flex items-center justify-center text-brand-green group-hover:bg-brand-green group-hover:text-white transition-colors">
                    <f.icon className="w-7 h-7" />
                </div>
                <div>
                    <h3 class="font-bold text-brand-dark text-xl mb-2">{f.title}</h3>
                    <p class="text-sm text-brand-dark/60 leading-relaxed">{f.desc}</p>
                </div>
             </div>
          ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <!-- CTA Section with Image Background & Glass Card -->
  <section class="relative py-32 overflow-hidden mx-4 md:mx-0 my-12 rounded-[50px] md:rounded-none">
    <div class="absolute inset-0 z-0">
        <Image src={import('../../assets/images/t_stippie_02.jpg')} alt="Scenic View" class="w-full h-full object-cover" quality="high" />
        <!-- Subtle dark gradient only at bottom for depth, not affecting text readability which is now in card -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    </div>
    
    <div class="container mx-auto px-6 relative z-10 flex justify-center items-center">
        <div class="bg-white/90 backdrop-blur-xl p-8 md:p-12 rounded-3xl shadow-2xl max-w-4xl w-full text-center border border-white/50 animate-slide-up hover:scale-[1.01] transition-transform duration-500">
            <h2 class="text-4xl md:text-6xl font-heading font-black mb-6 text-brand-green">{c.ctaTitle}</h2>
            <p class="text-lg md:text-xl text-brand-dark/80 mb-10 max-w-2xl mx-auto leading-relaxed">
                {c.ctaText}
            </p>
            <a href={getRelativeLocaleUrl(lang as string, 'boeken')} class="inline-flex items-center gap-3 bg-brand-green text-white font-bold text-lg px-10 py-4 rounded-full hover:bg-brand-dark transition-all shadow-xl hover:shadow-2xl transform hover:-translate-y-1 group">
                {t('btn.book')}
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
        </div>
    </div>
  </section>
</Layout>
