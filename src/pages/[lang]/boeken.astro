---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import bookingImage from '../../assets/images/vdg/vdg_31.webp'; // Nice interior/breakfast shot

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const content = {
  nl: { title: "Reserveren", intro: "Kies uw data en stel uw ideale verblijf samen." },
  en: { title: "Booking", intro: "Select dates and customize your stay." },
  de: { title: "Buchen", intro: "Wählen Sie Ihre Daten und gestalten Sie Ihren Aufenthalt." }
};

const c = content[lang as keyof typeof content];
---

<Layout title={`B&B Van de Gruiterwonen | ${t('nav.booking')}`}>
  <div class="pt-36 md:pt-36 pb-12 bg-brand-light min-h-screen">
    <div class="container mx-auto px-6">
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h1 class="text-4xl md:text-5xl font-heading font-black text-brand-brown mb-6 animate-slide-up">{c.title}</h1>
            <p class="text-lg text-brand-taupe/70 leading-relaxed animate-slide-up delay-100">{c.intro}</p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-start max-w-6xl mx-auto">
            <!-- Booking Form -->
            <div class="bg-white p-8 md:p-10 rounded-3xl shadow-xl border border-brand-gold/20 animate-slide-up delay-200">
                <form name="booking" method="POST" data-netlify="true" class="space-y-6">
                    
                    <!-- Dates -->
                    <div class="grid grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label for="checkin" class="block text-sm font-bold text-brand-taupe">{t('form.checkin')}</label>
                            <input type="date" id="checkin" name="checkin" required class="w-full px-4 py-3 rounded-lg bg-brand-light border-transparent focus:border-brand-gold focus:bg-white focus:ring-1 focus:ring-brand-gold/50 transition-colors text-brand-taupe" />
                        </div>
                        <div class="space-y-2">
                            <label for="checkout" class="block text-sm font-bold text-brand-taupe">{t('form.checkout')}</label>
                            <input type="date" id="checkout" name="checkout" required class="w-full px-4 py-3 rounded-lg bg-brand-light border-transparent focus:border-brand-gold focus:bg-white focus:ring-1 focus:ring-brand-gold/50 transition-colors text-brand-taupe" />
                        </div>
                    </div>

                    <!-- Guests -->
                     <div class="space-y-2">
                          <label for="guests" class="block text-sm font-bold text-brand-taupe">{t('form.guests')}</label>
                          <select id="guests" name="guests" class="w-full px-4 py-3 rounded-lg bg-brand-light border-transparent focus:border-brand-gold focus:bg-white focus:ring-1 focus:ring-brand-gold/50 transition-colors text-brand-taupe">
                              <option value="1">{t('booking.option.1person')}</option>
                              <option value="2" selected>{t('booking.option.2persons')}</option>
                          </select>
                     </div>

                     <!-- Extras -->
                     <div class="bg-brand-gold/5 p-6 rounded-xl border border-brand-gold/10">
                         <label class="flex items-center gap-3 cursor-pointer group">
                              <input type="checkbox" name="breakfast" value="yes" class="w-5 h-5 text-brand-gold rounded border-brand-taupe/20 focus:ring-brand-gold" checked disabled />
                              <span class="text-brand-taupe font-medium">{t('form.extra.breakfast')} (Inclusief)</span>
                         </label>
                     </div>

                     <!-- Personal Details -->
                     <div class="space-y-4">
                         <input type="text" name="name" placeholder={t('form.name')} required class="w-full px-4 py-3 rounded-lg bg-brand-light border-transparent focus:border-brand-gold focus:bg-white focus:ring-1 focus:ring-brand-gold/50 transition-colors placeholder:text-brand-taupe/40 text-brand-taupe" />
                         <input type="email" name="email" placeholder={t('form.email')} required class="w-full px-4 py-3 rounded-lg bg-brand-light border-transparent focus:border-brand-gold focus:bg-white focus:ring-1 focus:ring-brand-gold/50 transition-colors placeholder:text-brand-taupe/40 text-brand-taupe" />
                         <textarea name="remarks" rows="3" placeholder={t('form.remarks')} class="w-full px-4 py-3 rounded-lg bg-brand-light border-transparent focus:border-brand-gold focus:bg-white focus:ring-1 focus:ring-brand-gold/50 transition-colors placeholder:text-brand-taupe/40 text-brand-taupe"></textarea>
                     </div>

                     <button type="submit" class="w-full bg-brand-gold text-white font-bold text-lg py-4 rounded-full shadow-lg hover:bg-brand-brown hover:scale-[1.02] active:scale-95 transition-all duration-300">
                         {t('form.send')}
                     </button>
                 </form>
             </div>

             <!-- Side Content (Image / Info) -->
             <div class="space-y-8 animate-slide-up delay-300 hidden lg:block">
                 <div class="relative rounded-3xl overflow-hidden shadow-2xl h-[400px]">
                     <Image src={bookingImage} alt="Delicious Breakfast" class="w-full h-full object-cover" quality="high" />
                     <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-8">
                         <p class="text-white font-heading font-bold text-2xl">{t('booking.startDay')}</p>
                     </div>
                 </div>

                 <div class="bg-white p-8 rounded-3xl shadow-lg border border-brand-gold/20">
                     <h3 class="text-xl font-bold text-brand-brown mb-4">{t('booking.whyDirect')}</h3>
                     <ul class="space-y-3 text-brand-taupe/80">
                         <li class="flex items-center gap-2">✓ {t('booking.bestPrice')}</li>
                         <li class="flex items-center gap-2">✓ {t('booking.contactOwners')}</li>
                         <li class="flex items-center gap-2">✓ {t('booking.flexible')}</li>
                     </ul>
                </div>
            </div>
        </div>
    </div>
  </div>
</Layout>
