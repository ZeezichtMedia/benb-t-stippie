---
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import { languages } from '../../i18n/ui'; // Fix: imports from ui.ts, not utils
import { Image } from 'astro:assets';
import logoImage from '../../assets/images/logo_new.png'; // Generated logo
import { MapPin, Menu, X, ChevronDown } from 'lucide-react';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { label: t('nav.accommodation'), href: getRelativeLocaleUrl(lang, 'accommodatie') },
  { label: t('nav.surroundings'), href: getRelativeLocaleUrl(lang, 'omgeving') },
  { label: t('nav.gallery'), href: getRelativeLocaleUrl(lang, 'gallerij') },
  { label: t('nav.contact'), href: getRelativeLocaleUrl(lang, 'contact') },
];
---

<header class="fixed w-full z-50 transition-all duration-300 bg-brand-cream/95 backdrop-blur-md border-b border-brand-gold/20 shadow-sm" id="navbar">
  <div class="container mx-auto px-6 py-2 flex justify-between items-center h-28 relative z-[60]">
    <a href={getRelativeLocaleUrl(lang, '')} class="block relative z-[60]">
       <Image src={logoImage} alt="Van de Gruiterwonen" class="h-24 w-auto object-contain" priority quality="high" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a href={item.href} class="text-brand-taupe hover:text-brand-gold font-medium transition-colors text-sm uppercase tracking-wide">
          {item.label}
        </a>
      ))}
      
      <!-- Language Picker -->
      <div class="relative group ml-2 border-l border-brand-gold/30 pl-6 h-6 flex items-center">
        <button class="flex items-center gap-1 uppercase font-bold text-xs text-brand-taupe hover:text-brand-gold transition-colors">
          {lang}
          <ChevronDown className="w-3 h-3 transition-transform group-hover:rotate-180" />
        </button>
        <div class="absolute right-0 top-full mt-4 w-32 bg-brand-cream rounded-xl shadow-xl border border-brand-gold/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right overflow-hidden z-50">
          {Object.entries(languages).map(([l, label]) => (
            <a href={getRelativeLocaleUrl(l, Astro.url.pathname.split('/').slice(2).join('/') || '')} class={`block px-4 py-3 text-sm transition-colors ${l === lang ? 'bg-brand-gold/10 text-brand-brown font-bold' : 'text-brand-taupe/70 hover:bg-brand-gold/5 hover:text-brand-brown'}`}>
              {label}
            </a>
          ))}
        </div>
      </div>

      <a href={getRelativeLocaleUrl(lang, 'boeken')} class="bg-brand-gold text-white px-6 py-2.5 rounded-full text-sm font-bold hover:bg-brand-brown transition-all transform hover:scale-105 shadow-lg flex items-center gap-2">
        {t('btn.book')}
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-brand-taupe p-2 hover:bg-brand-gold/10 rounded-full transition-colors relative z-[60]" aria-label="Toggle Menu" aria-expanded="false" aria-controls="mobile-menu">
      <Menu className="w-8 h-8 transition-opacity duration-300" id="menu-icon-open" />
      <X className="w-8 h-8 transition-opacity duration-300 opacity-0 absolute top-2 left-2" id="menu-icon-close" />
    </button>
  </div>
</header>

<!-- Mobile Menu Overlay - Moved outside header to prevent clipping -->
<!-- z-40 to sit below Header (z-50) but above Hero content (usually z-0 to z-20) -->
<div id="mobile-menu" class="fixed inset-0 bg-brand-cream z-40 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col items-center pt-36 pb-8 px-6 overflow-y-auto" aria-hidden="true">
   
   <div class="mb-6 animate-fade-in-up">
       <span class="font-heading text-2xl font-bold text-brand-brown">Van de Gruiterwonen</span>
   </div>

   <nav class="flex flex-col gap-6 text-center w-full max-w-sm mx-auto flex-1 justify-center">
     {navItems.map((item) => (
        <a href={item.href} class="text-2xl font-heading font-bold text-brand-taupe hover:text-brand-gold transition-colors py-2 mobile-nav-link">
          {item.label}
        </a>
      ))}
   </nav>

   <div class="flex flex-col items-center gap-6 mt-8 w-full">
      <a href={getRelativeLocaleUrl(lang, 'boeken')} class="bg-brand-gold text-white px-10 py-3 rounded-full text-lg font-bold hover:bg-brand-brown transition-all shadow-lg w-full max-w-xs text-center">
          {t('btn.book')}
      </a>

      <div class="flex gap-4 pt-6 border-t border-brand-gold/20 w-full max-w-xs justify-center">
          {Object.entries(languages).map(([l, label]) => (
              <a 
              href={getRelativeLocaleUrl(l, Astro.url.pathname.split('/').slice(2).join('/') || '')} 
              class={`uppercase font-bold text-sm px-4 py-2 rounded-full transition-colors ${l === lang ? 'bg-brand-gold text-white shadow-md' : 'text-brand-taupe/60 hover:text-brand-brown hover:bg-brand-gold/10'}`}
              >
                  {l}
              </a>
          ))}
      </div>
   </div>
</div>

<script>
  function setupMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll('.mobile-nav-link');
    
    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      
      // Update DOM with slide transform
      menu?.classList.toggle('translate-x-full', !isMenuOpen);
      menu?.setAttribute('aria-hidden', (!isMenuOpen).toString());
      
      // Update Button State
      menuBtn?.setAttribute('aria-expanded', isMenuOpen.toString());
      
      if (isMenuOpen) {
          openIcon?.classList.add('opacity-0');
          closeIcon?.classList.remove('opacity-0');
          document.body.style.overflow = 'hidden';
      } else {
          openIcon?.classList.remove('opacity-0');
          closeIcon?.classList.add('opacity-0');
          document.body.style.overflow = '';
      }
    }

    menuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
    });

    navLinks.forEach(link => {
        link.addEventListener('click', () => {
             if (isMenuOpen) toggleMenu();
        });
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isMenuOpen) {
            toggleMenu();
        }
    });

    // Close on resize if switching to desktop
    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && isMenuOpen) {
            toggleMenu();
        }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
