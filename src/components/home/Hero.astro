---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/vdg/vdg_31.webp';


interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaLink: string;
}

const { title, subtitle, ctaText, ctaLink } = Astro.props;
---

<section class="min-h-[85vh] flex items-center bg-brand-light relative overflow-hidden pt-36 pb-12">
  <!-- Decorative Background Blob -->
  <div class="absolute top-0 right-0 w-2/3 h-full bg-brand-gold/10 rounded-l-[100px] z-0 hidden lg:block"></div>

  <div class="container mx-auto px-6 relative z-10 flex flex-col-reverse lg:grid lg:grid-cols-2 gap-12 items-center">
    <!-- Text Content -->
    <div class="space-y-8 text-center lg:text-left">
      <h1 class="text-4xl xs:text-5xl md:text-7xl font-heading font-black text-brand-brown leading-[1.1] tracking-tight animate-slide-up">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-brand-taupe/80 font-body max-w-lg mx-auto lg:leading-relaxed animate-slide-up delay-100 lg:border-l-4 lg:border-brand-gold lg:pl-6 lg:mx-0">
        {subtitle}
      </p>
      
      <div class="pt-4 animate-slide-up delay-200">
        <a href={ctaLink} class="inline-flex items-center gap-2 bg-brand-gold text-white font-bold text-lg px-8 py-4 rounded-full shadow-xl hover:bg-brand-brown hover:scale-105 transition-all duration-300 group">
           {ctaText}
           <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    </div>

    <!-- Hero Image (Contained & Sharp) -->
    <div class="relative animate-fade-in delay-300 w-full max-w-lg mx-auto lg:max-w-none">
        <div class="absolute inset-0 bg-brand-brown/10 transform translate-x-2 translate-y-2 md:translate-x-4 md:translate-y-4 rounded-3xl md:rounded-[40px] z-0"></div>
        <Image 
          src={heroImage} 
          alt="B&B Van de Gruiterwonen" 
          class="relative z-10 w-full h-[350px] md:h-[500px] object-cover rounded-3xl md:rounded-[40px] shadow-2xl md:skew-y-1 md:hover:skew-y-0 transition-transform duration-700"
          quality="high"
        />
        
        <!-- Floating Badge -->
        <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 md:translate-x-0 md:left-auto md:-left-6 z-20 bg-brand-cream p-4 md:p-6 rounded-2xl shadow-xl border border-brand-gold/20 transform hover:scale-105 transition-transform duration-300 whitespace-nowrap">
           <div class="text-center">
               <span class="block text-[10px] md:text-xs uppercase tracking-widest text-brand-taupe/60 font-bold">Locatie</span>
               <span class="block text-lg md:text-xl font-heading font-bold text-brand-brown">Axel</span>
           </div>
        </div>
    </div>
  </div>
</section>

<style>
  /* Removed unused parallax styles */
</style>
